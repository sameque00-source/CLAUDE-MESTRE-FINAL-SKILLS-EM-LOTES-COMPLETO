{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:20128/v1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "imperion-dev",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "imperion-dev",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "imperion-dev",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
    "CLAUDE_FLOW_MAX_AGENTS": "8",
    "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
    "FREE_ONLY": "true"
  },
  "permissions": {
    "allow": [
      "Read","Glob","Grep","TodoWrite","WebFetch","WebSearch","Write","Edit",
      "Bash(ls:*)","Bash(cat:*)","Bash(head:*)","Bash(tail:*)","Bash(wc:*)","Bash(stat:*)",
      "Bash(find:*)","Bash(grep:*)","Bash(sha256sum:*)","Bash(diff:*)","Bash(mkdir:*)",
      "Bash(git status:*)","Bash(git log:*)","Bash(git diff:*)","Bash(git show:*)",
      "Bash(git add:*)","Bash(git commit:*)","Bash(node:*)","Bash(npm:*)","Bash(npx:*)",
      "Bash(python:*)","Bash(python3:*)","Bash(pwsh:*)","Bash(powershell:*)",
      "Bash(curl -s http://127.0.0.1:20128/*)","Bash(curl -s http://localhost:20128/*)",
      "Bash(curl -sf http://127.0.0.1:20128/*)","Bash(curl -sf http://localhost:20128/*)",
      "mcp__playwright__*","mcp__claude-flow__*"
    ],
    "deny": [
      "Read(C:/Users/Administrator/.ssh/**)","Read(**/.ssh/**)","Read(**/id_rsa*)","Read(**/id_ed25519*)",
      "Read(**/.env)","Read(**/.env.*)","Read(**/.npmrc)","Read(**/jwt-secret)","Read(**/cli-secret)",
      "Read(C:/Users/Administrator/.claude/settings.json)",
      "Edit(C:/Users/Administrator/Documents/Imperiom Fivem/**)","Edit(C:/Users/Administrator/Documents/Vs code claude/**)",
      "Edit(C:/Users/Administrator/.ssh/**)","Edit(**/.env)","Edit(**/.env.*)",
      "Bash(ssh:*)","Bash(scp:*)","Bash(sftp:*)","Bash(rsync:*)","Bash(rm -rf:*)","Bash(format:*)"
    ]
  },
  "enableWorkflows": true,
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "maxThinkingTokens": 12000,
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["claude-flow","playwright"],
  "hooks": {}
}
