{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Workspace CLAUDE CODE VS FINAL. Nao contem secrets. A ANTHROPIC_API_KEY vem do settings.json global em %USERPROFILE%\\.claude\\settings.json",

  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:20128/v1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "imperion-dev",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "imperion-dev",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "imperion-dev",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "imperion-dev",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
    "CLAUDE_FLOW_MAX_AGENTS": "25",
    "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
    "FREE_ONLY": "true"
  },

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write",
      "Edit",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sha256sum:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pwsh:*)",
      "Bash(powershell:*)",
      "Bash(curl -s http://127.0.0.1:20128/*)",
      "Bash(curl -s http://localhost:20128/*)",
      "Bash(curl -sf http://127.0.0.1:20128/*)",
      "Bash(curl -sf http://localhost:20128/*)",
      "mcp__playwright__*",
      "mcp__claude-flow__*"
    ],
    "_comment_deny": "Caminhos SEMPRE em sintaxe Windows (C:/...). Sintaxe Git Bash nao casa aqui. Regras de arquivo usam Edit(), nao Write(): Edit cobre todas as ferramentas de escrita.",
    "deny": [
      "Read(C:/Users/Administrator/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.npmrc)",
      "Read(**/jwt-secret)",
      "Read(**/cli-secret)",
      "Read(C:/Users/Administrator/.claude/settings.json)",

      "Edit(C:/Users/Administrator/Documents/Imperiom Fivem/**)",
      "Edit(C:/Users/Administrator/Documents/Vs code claude/**)",
      "Edit(C:/Users/Administrator/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",

      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(rm -rf:*)",
      "Bash(format:*)"
    ]
  },

  "model": "opus",
  "enableWorkflows": true,
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "maxThinkingTokens": 16000,

  "_comment_mcp": "Pre-aprova os MCP servers declarados no .mcp.json deste workspace, para nao pedir confirmacao ao abrir",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["claude-flow", "playwright"],

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"IF EXIST \"%USERPROFILE%\\.claude\\helpers\\hook-handler.cjs\" (node \"%USERPROFILE%\\.claude\\helpers\\hook-handler.cjs\" session-restore) ELSE (echo skip)\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"IF EXIST \"%USERPROFILE%\\.claude\\helpers\\hook-handler.cjs\" (node \"%USERPROFILE%\\.claude\\helpers\\hook-handler.cjs\" session-end) ELSE (echo skip)\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"IF EXIST \"%USERPROFILE%\\.claude\\helpers\\hook-handler.cjs\" (node \"%USERPROFILE%\\.claude\\helpers\\hook-handler.cjs\" post-edit) ELSE (echo skip)\"",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
